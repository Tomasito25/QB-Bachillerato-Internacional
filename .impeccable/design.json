  "narrative": {
    "northStar": "El cartel que avanza",
    "overview": "Estilo tipográfico internacional aplicado a una herramienta de estudio: retícula estricta, grotesca enorme y campos de color planos. La pieza central es la banda de progreso: la cabecera de cada pantalla con algo que medir se rellena de color, y la cifra gigante cambia de color justo al cruzar el borde del relleno.",
    "keyCharacteristics": [
      "Barra lateral negra a sangre y activo en acento hasta el borde.",
      "Cabeceras a sangre: banda de progreso, o campo de tinta cuando no hay nada que medir.",
      "Cifras en Archivo Black; lectura en Inter.",
      "Esquinas rectas, reglas negras, ninguna sombra.",
      "Amarillo señal sólo para lo que te necesita ahora."
    ],
    "rules": [
      {
        "name": "The No Grey Fill Rule",
        "body": "Ninguna superficie es gris: es tinta, papel o un tinte del acento. Los grises sólo existen como color de texto secundario.",
        "section": "colors"
      },
      {
        "name": "The Signal Rule",
        "body": "El amarillo sólo marca lo que te necesita ahora. Si todo es urgente, nada lo es.",
        "section": "colors"
      },
      {
        "name": "The Strong Color Rule",
        "body": "El color fuerte recorre lo que estás haciendo en este momento: dónde estás, cuánto llevas y qué pulsar.",
        "section": "colors"
      },
      {
        "name": "The Two Extremes Rule",
        "body": "O texto de lectura o cartel. Casi nada en medio.",
        "section": "typography"
      },
      {
        "name": "The Square Rule",
        "body": "Si tiene esquinas, son rectas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar la banda de progreso en toda cabecera que tenga algo que medir.",
      "Do usar el campo de tinta en las cabeceras sin nada que medir.",
      "Do dejar la pregunta en Inter, sobre papel y a 42 rem como máximo.",
      "Do escribir siempre el dato exacto junto a cualquier barra."
    ],
    "donts": [
      "Don't usar sombras, degradados o esquinas redondeadas.",
      "Don't rellenar superficies con gris.",
      "Don't usar el amarillo como decoración.",
      "Don't poner etiquetas pequeñas en mayúsculas encima de los títulos.",
      "Don't imitar documentos ni la identidad de la Organización del Bachillerato Internacional."
    ]
  }
