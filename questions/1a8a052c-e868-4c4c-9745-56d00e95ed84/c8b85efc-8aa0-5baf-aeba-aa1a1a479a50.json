    {
      "id": "c",
      "statement": "Calcula el rendimiento teórico de cloruro de aluminio.",
      "modelAnswer": "$n(\\mathrm{AlCl_3}) = 0{,}100 \\times \\dfrac{2}{3} = 0{,}0667\\,\\text{mol}$; $m = 0{,}0667 \\times 133{,}33 = 8{,}89\\,\\text{g}$. (1)",
