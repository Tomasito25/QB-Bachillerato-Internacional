  "parts": [
    {
      "id": "a",
      "statement": "Calcula la resistencia total del circuito.",
      "modelAnswer": "$R_2$ y $R_3$ en paralelo: $\\frac{1}{R} = \\frac{1}{6{,}0} + \\frac{1}{3{,}0}$, de donde $R = 2{,}0\\,\\Omega$. En total: $1{,}0 + 2{,}0 + 2{,}0 = 5{,}0\\,\\Omega$.",
      "marks": 2
    },
    {
      "id": "b",
      "statement": "Calcula la corriente que suministra la pila.",
      "modelAnswer": "$I = \\frac{\\varepsilon}{R_T} = \\frac{9{,}0}{5{,}0} = 1{,}8\\,\\text{A}$.",
      "marks": 1
    },
    {
      "id": "c",
      "statement": "Determina la diferencia de potencial entre los bornes de la pila.",
      "modelAnswer": "$V = \\varepsilon - Ir = 9{,}0 - 1{,}8 \\cdot 1{,}0 = 7{,}2\\,\\text{V}$.",
      "marks": 1
    },
    {
      "id": "d",
      "statement": "Calcula la corriente que pasa por $R_3$.",
      "modelAnswer": "En el paralelo, $V = 1{,}8 \\cdot 2{,}0 = 3{,}6\\,\\text{V}$, así que $I_3 = \\frac{3{,}6}{3{,}0} = 1{,}2\\,\\text{A}$.",
      "marks": 2
    },
    {
      "id": "e",
      "statement": "Calcula la potencia disipada dentro de la pila.",
      "modelAnswer": "$P = I^2 r = 1{,}8^2 \\cdot 1{,}0 = 3{,}2\\,\\text{W}$.",
      "marks": 1
    }
  ]
