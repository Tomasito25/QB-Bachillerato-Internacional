    {
      "id": "a",
      "text": "Aumentar un poco la amplitud.",
      "correct": false,
      "feedback": "Para ángulos pequeños, el periodo no depende de la amplitud."
    },
    {
      "id": "b",
      "text": "Alargar el péndulo.",
      "correct": false,
      "feedback": "Eso aumentaría el periodo y atrasaría aún más."
