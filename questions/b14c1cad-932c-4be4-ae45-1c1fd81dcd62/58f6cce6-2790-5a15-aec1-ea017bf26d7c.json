  "answers": [
    {
      "id": "a",
      "text": "Una recta que pasa por el origen, de pendiente $GM$.",
      "correct": true
    },
    {
      "id": "b",
      "text": "Una recta de pendiente $-GM$.",
      "correct": false,
      "feedback": "La pendiente es positiva: g aumenta con 1/r²."
    },
    {
      "id": "c",
      "text": "Una curva decreciente.",
      "correct": false,
      "feedback": "Al representar frente a 1/r², la relación es lineal."
    },
    {
      "id": "d",
      "text": "Una recta horizontal.",
      "correct": false,
      "feedback": "g varía con la distancia."
