      "id": "17d97ec8-ece0-4c28-a3d4-842926016850",
      "rev": 1,
      "statement": "Un objeto parte del reposo con una aceleración constante de $2\\,\\text{m s}^{-2}$. ¿Qué velocidad tiene a los $3\\,\\text{s}$?",
      "images": [],
      "difficulty": 2,
      "subjectId": "cdd8cf0e-2bce-418d-9242-d457f28a10da",
      "topicIds": [
        "a92ae354-7f00-4bf6-8608-6e85fb1de8d7"
      ],
      "tags": [
        "MRUA"
      ],
      "references": [],
      "author": null,
      "createdAt": "2026-11-08T10:00:00Z",
      "updatedAt": "2026-11-08T10:00:00Z",
      "license": "CC-BY-SA-4.0",
      "explanation": "Con aceleración constante, $v = u + at = 0 + 2 \\cdot 3 = 6\\,\\text{m s}^{-1}$.",
      "type": "mcq",
      "answers": [
        {
          "id": "a",
          "text": "$1{,}5\\,\\text{m s}^{-1}$",
          "correct": false,
          "feedback": "Eso es dividir la aceleración entre el tiempo: hay que multiplicar."
        },
        {
          "id": "b",
          "text": "$5\\,\\text{m s}^{-1}$",
          "correct": false
        },
        {
          "id": "c",
          "text": "$6\\,\\text{m s}^{-1}$",
          "correct": true
        },
        {
          "id": "d",
          "text": "$9\\,\\text{m s}^{-1}$",
          "correct": false,
          "feedback": "$9\\,\\text{m}$ es la distancia recorrida en esos 3 s, no la velocidad."
        }
      ],
      "multiple": false,
      "reveal": {
        "explanationAfterAnswer": true,
        "solutionsAtExamEnd": true
      }
    },
