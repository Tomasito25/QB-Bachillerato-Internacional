# Sólo valores públicos: todo lo que empiece por VITE_ acaba en el bundle.
# NUNCA pongas aquí un token de GitHub.

# Repositorio comunitario, como propietario/nombre. En Actions se toma de `github.repository`.
VITE_COMMUNITY_REPO=propietario/questionbank

# Ruta de la app. En Actions se toma de `actions/configure-pages`.
# QB_BASE=/questionbank/
